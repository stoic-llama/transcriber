# Optional build-time settings. Never put an OpenAI API key here: the key is
# entered by each user in the browser at runtime.

# Where the ffmpeg.wasm core (ffmpeg-core.js + ffmpeg-core.wasm) is loaded from.
# Default: jsDelivr CDN. Set to "./ffmpeg" after `npm run vendor:ffmpeg` to self-host.
# VITE_FFMPEG_CORE_BASE_URL=./ffmpeg
